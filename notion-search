#!/bin/bash
# Notion Search: control panel. Run `notion-search` for the menu, or pass a command:
#   install | status | restart | reindex | uninstall [--purge]   (logs: for debugging)
set -uo pipefail

SRC="${BASH_SOURCE[0]}"; while [[ -L "$SRC" ]]; do SRC="$(readlink "$SRC")"; done
DIR="$(cd "$(dirname "$SRC")" && pwd)"
LABEL="com.notionsearch.service"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/NotionSearch.log"
DATA="$HOME/Library/Application Support/NotionSearch"
LINK="$HOME/.local/bin/notion-search"
PY="$DIR/.venv/bin/python"
DOMAIN="gui/$(id -u)"

trap 'printf "\n  Stopped.\n"; tput cnorm 2>/dev/null; exit 130' INT

B=$'\033[1m'; D=$'\033[2m'; C=$'\033[36m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; N=$'\033[0m'
ok() { echo "  ${G}✓${N} $*"; }
die() { echo "  ${R}✗${N} $*"; return 1; }
step() { echo "  ${C}•${N} $*"; }

pid() { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^\tpid =/{print $3}'; }
pages() { sqlite3 "$DATA/index.db" "select count(*) from pages" 2>/dev/null || echo 0; }
stop() { launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true; }

state_line() {
  if [[ ! -f "$PLIST" ]]; then echo "${D}○ not installed${N}"
  elif [[ -n "$(pid)" ]]; then echo "${G}● running${N} ${D}· $(pages) pages indexed${N}"
  else echo "${Y}○ installed, not running${N}"; fi
}

# A progress bar while pip works. pip prints one "Collecting" line per package, so those count the progress.
bar() { # bar DONE TOTAL
  local n=$(( 30 * $1 / $2 )) pct=$(( 100 * $1 / $2 ))
  printf '\r  %s[%s%s]%s %3d%%' "$C" "$(printf '█%.0s' $(seq 1 $n))" "$(printf '░%.0s' $(seq 1 $((30 - n))))" "$N" "$pct"
}

pip_with_bar() { # pip_with_bar PIP_ARGS...
  local log total=45 n rc; log="$(mktemp)"
  "$PY" -m pip install --progress-bar off "$@" >"$log" 2>&1 &
  local job=$!
  while kill -0 "$job" 2>/dev/null; do
    n=$(grep -c '^Collecting' "$log"); grep -q '^Installing collected' "$log" && n=$((total - 1))
    (( n >= total )) && n=$((total - 1)); (( n < 1 )) && n=1
    [[ -t 1 ]] && bar "$n" "$total"
    sleep 0.4
  done
  wait "$job"; rc=$?
  if [[ $rc -eq 0 ]]; then [[ -t 1 ]] && { bar 1 1; echo; }; else echo; tail -n 15 "$log"; fi
  rm -f "$log"; return $rc
}

make_venv() {
  local deps=("mlx==0.32.3" "transformers==5.19.0" "huggingface-hub>=1.33" "numpy>=2.5" websockets
              # mlx-vlm: EmbeddingGemma 2 support is on its main branch, not on PyPI yet (the commit DigUp pins).
              "mlx-vlm @ https://github.com/Blaizzy/mlx-vlm/archive/fec3f50379bb2cb0760ef3c8a68ebce9585e4d97.zip")
  local py312; py312="$(command -v python3.12 || true)"
  rm -rf "$DIR/.venv"
  if [[ -n "$py312" ]]; then
    step "Setting up Python environment (a few minutes, once)"
    "$py312" -m venv "$DIR/.venv" && "$PY" -m pip install -q --upgrade pip && pip_with_bar "${deps[@]}"
  else
    step "Python 3.12 not found: fetching it with uv (a few minutes, once)"
    export PATH="$HOME/.local/bin:$PATH"
    command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh >/dev/null || return 1
    uv venv --python 3.12 "$DIR/.venv" && uv pip install --python "$PY" "${deps[@]}"
  fi
}

do_install() {
  [[ "$(uname -s)-$(uname -m)" == "Darwin-arm64" ]] || { die "Needs a Mac with Apple Silicon (MLX)."; return 1; }
  [[ -d /Applications/Notion.app ]] || { die "Install Notion Desktop first (/Applications/Notion.app)."; return 1; }
  stop; pkill -f notion_service.py 2>/dev/null || true
  step "Step 1 of 4 · Python environment"
  # Rebuild when missing, broken, or an old environment that carries PyTorch (unused, +300 MB in memory).
  if [[ ! -x "$PY" ]] || ! "$PY" -c "import mlx_vlm, websockets" 2>/dev/null || "$PY" -c "import torch" 2>/dev/null; then
    make_venv || return 1
  else echo "  Already set up"; fi
  ok "Python environment ready"

  step "Step 2 of 4 · Language model (Google EmbeddingGemma 2)"
  (cd "$DIR" && PYTHONWARNINGS=ignore "$PY" -u notion_service.py --download) || { die "Model download failed. Check your internet connection and run this again."; return 1; }
  ok "Language model ready"

  step "Step 3 of 4 · Indexing your pages"
  (cd "$DIR" && PYTHONWARNINGS=ignore "$PY" -u notion_service.py --index) || { die "Indexing failed."; return 1; }
  ok "Index built"

  step "Step 4 of 4 · Background service"
  mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG")" "$(dirname "$LINK")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$PY</string><string>-u</string><string>$DIR/notion_service.py</string></array>
  <key>WorkingDirectory</key><string>$DIR</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
EOF
  launchctl bootstrap "$DOMAIN" "$PLIST" && ok "Background service started (and starts at every login)"
  ln -sf "$DIR/notion-search" "$LINK" && ok "Command installed: notion-search"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "  ${Y}!${N} add ~/.local/bin to your PATH to run it from anywhere" ;; esac
  echo; echo "  Use Notion as usual and press Cmd+K. (If Notion was open, it restarts once.)"
}

do_status() {
  echo "  $(state_line)"
  if [[ -f "$PLIST" ]]; then
    if ps -axo command= | grep -q "^/Applications/Notion.app/Contents/MacOS/Notion --remote-debugging-port"; then
      ok "Notion is running with the search hook"
    elif ps -axo command= | grep -q "^/Applications/Notion.app/Contents/MacOS/Notion"; then
      echo "  ${Y}!${N} Notion is open without the hook; the service restarts it within seconds"
    else echo "  ${D}Notion is not open${N}"; fi
    echo; tail -n 6 "$LOG" 2>/dev/null | sed 's/^/  '"$D"'/; s/$/'"$N"'/'
  fi
}

do_restart() { [[ -f "$PLIST" ]] || { die "Not installed."; return 1; }
  launchctl kickstart -k "$DOMAIN/$LABEL" && ok "Restarted"; }

do_reindex() { [[ -f "$PLIST" ]] || { die "Not installed."; return 1; }
  stop; rm -f "$DATA"/index.db*
  step "Rebuilding the index"
  (cd "$DIR" && PYTHONWARNINGS=ignore "$PY" -u notion_service.py --index)
  launchctl bootstrap "$DOMAIN" "$PLIST" && ok "Done, service running"; }

do_uninstall() {
  stop; rm -f "$PLIST" "$LINK"; ok "Service removed (Notion itself was never modified)"
  if [[ "${1:-}" == "--purge" ]]; then
    rm -rf "$DATA" "$LOG" "$DIR/.venv"; ok "Index, model (0.9 GB), log and Python environment deleted"
    
  else echo "  ${D}Kept the index and Python environment: install again anytime.${N}"; fi
}

# ── menu ────────────────────────────────────────────────────────────────────

header() { printf '\033[H\033[2J\n  %sNotion Search%s\n  %s\n\n' "$B" "$N" "$(state_line)"; }

pick() {  # pick OPTION...  -> CHOICE = chosen index; returns 1 on q/esc
  local opts=("$@") sel=0 key k2 i
  tput civis 2>/dev/null
  while true; do
    header
    for i in "${!opts[@]}"; do
      local label="${opts[$i]%%|*}" desc=""; [[ "${opts[$i]}" == *"|"* ]] && desc="${opts[$i]#*|}"
      if [[ $i -eq $sel ]]; then printf '  %s❯ %-11s%s %s%s%s\n' "$C" "$label" "$N" "$D" "$desc" "$N"
      else printf '    %-11s %s%s%s\n' "$label" "$D" "$desc" "$N"; fi
    done
    printf '\n  %s↑↓ move · enter select · q quit%s\n' "$D" "$N"
    IFS= read -rsn1 key
    case "$key" in
      $'\033') read -rsn2 -t 1 k2 || true
               case "$k2" in '[A') ((sel = (sel + ${#opts[@]} - 1) % ${#opts[@]}));; '[B') ((sel = (sel + 1) % ${#opts[@]}));; *) tput cnorm 2>/dev/null; return 1;; esac;;
      k) ((sel = (sel + ${#opts[@]} - 1) % ${#opts[@]}));;
      j) ((sel = (sel + 1) % ${#opts[@]}));;
      q) tput cnorm 2>/dev/null; return 1;;
      '') CHOICE=$sel; tput cnorm 2>/dev/null; return 0;;
    esac
  done
}

menu() {
  while true; do
    local install_label="Install|Set up the search service and index your Notion"
    [[ -f "$PLIST" ]] && install_label="Update|Reinstall the service and refresh dependencies"
    pick "$install_label" \
      "Status|Is it running, and is Notion hooked?" \
      "Restart|Restart the background service" \
      "Reindex|Re-read all your Notion pages from scratch" \
      "Uninstall|Remove the service (your Notion is never touched)" \
      "Quit|Close this menu" || break
    header
    case $CHOICE in
      0) do_install;; 1) do_status;; 2) do_restart;; 3) do_reindex;;
      4) pick "Service|Remove the service only; keep the index and model" \
              "Everything|Also delete the index, model and Python environment (frees about 1.7 GB)" \
              "Cancel|Go back" && header &&
         case $CHOICE in 0) do_uninstall;; 1) do_uninstall --purge;; *) continue;; esac;;
      5) break;;
    esac
    printf '\n  %sPress any key to go back%s' "$D" "$N"; read -rsn1 _
  done
  tput cnorm 2>/dev/null; clear
}

case "${1:-menu}" in
  menu) if [[ -t 0 && -t 1 ]]; then menu; else sed -n 2,3p "$0"; fi ;;
  install) do_install;; status) do_status;; restart) do_restart;; reindex) do_reindex;;
  logs) tail -f "$LOG";; uninstall) do_uninstall "${2:-}";;
  *) sed -n 2,3p "$0"; exit 1;;
esac
