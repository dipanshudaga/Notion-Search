#!/bin/bash
# Notion Search: control panel. Run `notion-search` for the menu, or pass a command:
#   install | status | restart | reindex | uninstall [--purge]   (logs: for debugging)
set -uo pipefail

SRC="${BASH_SOURCE[0]}"; while [[ -L "$SRC" ]]; do SRC="$(readlink "$SRC")"; done
DIR="$(cd "$(dirname "$SRC")" && pwd)"
LABEL="com.notionsearch.service"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/NotionSearch.log"
DATA="$HOME/Library/Application Support/NotionSearch"
LINK="$HOME/.local/bin/notion-search"
PY="$DIR/.venv/bin/python"
DOMAIN="gui/$(id -u)"

trap 'printf "\n  Stopped.\n"; tput cnorm 2>/dev/null; exit 130' INT

B=$'\033[1m'; D=$'\033[2m'; C=$'\033[36m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; N=$'\033[0m'
ok() { echo "${D}│${N}  ${G}✓${N} $*"; }
die() { echo "${D}│${N}  ${R}✗${N} $*"; return 1; }
step() { echo "${D}│${N}  ${C}•${N} $*"; }

pid() { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^\tpid =/{print $3}'; }
pages() { sqlite3 "$DATA/index.db" "select count(*) from pages" 2>/dev/null || echo 0; }
stop() { launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true; }

state_line() {
  if [[ ! -f "$PLIST" ]]; then echo "${D}○ not installed${N}"
  elif [[ -n "$(pid)" ]]; then echo "${G}● running${N} ${D}· $(pages) pages indexed${N}"
  else echo "${Y}○ installed, not running${N}"; fi
}

# ── installer UI: a live checklist, one line per step, a bar on the active one ───────────────────
UI_TTY=0; [[ -t 1 ]] && UI_TTY=1
UI_NAMES=(); UI_STATE=(); UI_DETAIL=(); UI_CAPTION=""; UI_DRAWN=0; UI_ACTIVE=0; UI_T0=0

rep() { local out="" i; for ((i = 0; i < $2; i++)); do out+="$1"; done; printf '%s' "$out"; }
bar_str() { # bar_str DONE TOTAL
  local n=$(( 24 * $1 / $2 )); (( n > 24 )) && n=24
  printf '%s%s%s%s%s %3d%%' "$C" "$(rep '━' $n)" "$D" "$(rep '─' $((24 - n)))" "$N" $(( 100 * $1 / $2 ))
}

ui_draw() {
  [[ $UI_TTY -eq 1 ]] || return 0
  local i line name
  (( UI_DRAWN )) && printf '\033[%dA' $(( ${#UI_NAMES[@]} + 2 ))
  for i in "${!UI_NAMES[@]}"; do
    printf -v name '%-24s' "${UI_NAMES[$i]}"
    case "${UI_STATE[$i]}" in
      done)   line="${D}│${N}  ${G}✓${N} $name ${D}${UI_DETAIL[$i]}${N}";;
      active) line="${D}│${N}  ${C}●${N} ${B}$name${N} ${UI_DETAIL[$i]}";;
      fail)   line="${D}│${N}  ${R}✗${N} $name ${R}${UI_DETAIL[$i]}${N}";;
      *)      line="${D}│${N}  ${D}○ $name${N}";;
    esac
    printf '\033[K%s\n' "$line"
  done
  printf '\033[K%s│%s\n\033[K%s│%s  %s%s%s\n' "$D" "$N" "$D" "$N" "$D" "$UI_CAPTION" "$N"
  UI_DRAWN=1
}

ui_init() { # ui_init STEP_NAME...
  UI_NAMES=("$@"); UI_STATE=(); UI_DETAIL=(); UI_CAPTION=""; UI_DRAWN=0
  local _; for _ in "$@"; do UI_STATE+=(pending); UI_DETAIL+=(""); done
  printf '\n%s┌%s  %sNotion Search%s  %s· %s%s\n%s│%s\n' "$D" "$N" "$B" "$N" "$D" "${UI_TITLE:-installer}" "$N" "$D" "$N"
  ui_draw
}
ui_start() { UI_ACTIVE=$1; UI_STATE[$1]=active; UI_DETAIL[$1]=""; UI_T0=$SECONDS; UI_CAPTION=""
  [[ $UI_TTY -eq 1 ]] && ui_draw || echo "  [$(($1 + 1))/${#UI_NAMES[@]}] ${UI_NAMES[$1]}..."; }
ui_done() { UI_STATE[$1]=done; UI_DETAIL[$1]="${2:-$((SECONDS - UI_T0))s}"; UI_CAPTION=""; ui_draw; }
ui_fail() { UI_STATE[$UI_ACTIVE]=fail; UI_DETAIL[$UI_ACTIVE]="${1:-failed}"; ui_draw; }
ui_caption() { UI_CAPTION="$1"; ui_draw; }
ui_bar() { # ui_bar DONE TOTAL UNIT SCALE
  (( $2 > 0 )) || return 0
  UI_DETAIL[$UI_ACTIVE]="$(bar_str "$1" "$2")  ${D}$(( $1 / $4 ))/$(( $2 / $4 )) $3${N}"; ui_draw
}
ui_spin() { # ui_spin PID LABEL: animate until the background job PID ends
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) f=0 t=$SECONDS
  while kill -0 "$1" 2>/dev/null; do
    UI_DETAIL[$UI_ACTIVE]="${C}${frames[f % 10]}${N} ${D}$2 · $((SECONDS - t))s${N}"; ui_draw
    f=$((f + 1)); sleep 0.12
  done
}
ui_error() { # ui_error LOGFILE: show the last lines of a failed command under the checklist
  echo; echo "${D}│${N}  ${R}Something went wrong. Last lines:${N}"; tail -n 12 "$1" | sed "s/^/${D}│${N}    /"
}

run_py() { # run_py ARGS...: run notion_service.py and feed its @say / @progress lines to the UI
  local log rc; log="$(mktemp)"
  (cd "$DIR" && NS_PROTOCOL=1 PYTHONWARNINGS=ignore "$PY" -u notion_service.py "$@" 2>&1) | while IFS= read -r line; do
    case "$line" in
      "@say "*) ui_caption "${line#@say }";;
      "@progress "*) set -- ${line#@progress }; ui_bar "$1" "$2" "$3" "$4";;
      *) printf '%s\n' "$line" >> "$log";;
    esac
  done
  rc=${PIPESTATUS[0]}
  [[ $rc -eq 0 ]] || ui_error "$log"
  rm -f "$log"; return "$rc"
}

pip_step() { # pip_step ARGS...: pip prints a "Collecting" line per package, which counts the download phase
  local log n last job rc; log="$(mktemp)"
  "$PY" -m pip install --progress-bar off "$@" >"$log" 2>&1 &
  job=$!
  while kill -0 "$job" 2>/dev/null; do
    if grep -q '^Installing collected' "$log"; then ui_caption "Installing packages"; ui_spin_once "$job"
    else
      n=$(grep -c '^Collecting' "$log"); (( n > 55 )) && n=55; (( n < 1 )) && n=1
      last=$(grep '^Collecting' "$log" | tail -n 1 | cut -c1-60); ui_caption "${last:-Resolving packages}"
      ui_bar "$n" 60 packages 1; sleep 0.3
    fi
  done
  wait "$job"; rc=$?
  [[ $rc -eq 0 ]] || ui_error "$log"
  rm -f "$log"; return "$rc"
}
ui_spin_once() { # one animated frame while pip installs packages (no percentage is knowable here)
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  UI_DETAIL[$UI_ACTIVE]="${C}${frames[$((SECONDS * 8 % 10))]}${N} ${D}almost there · $((SECONDS - UI_T0))s${N}"; ui_draw; sleep 0.12
}

quiet_step() { # quiet_step LABEL CMD...: run a command with a spinner (used for uv, which has no machine-readable progress)
  local label="$1" log rc job; shift; log="$(mktemp)"
  "$@" >"$log" 2>&1 & job=$!
  ui_caption "$label"; ui_spin "$job" "$label"
  wait "$job"; rc=$?
  [[ $rc -eq 0 ]] || ui_error "$log"
  rm -f "$log"; return "$rc"
}

make_venv() {
  local deps=("mlx==0.32.3" "transformers==5.19.0" "huggingface-hub>=1.33" "numpy>=2.5" websockets
              # mlx-vlm: EmbeddingGemma 2 support is on its main branch, not on PyPI yet (the commit DigUp pins).
              "mlx-vlm @ https://github.com/Blaizzy/mlx-vlm/archive/fec3f50379bb2cb0760ef3c8a68ebce9585e4d97.zip")
  local py312; py312="$(command -v python3.12 || true)"
  rm -rf "$DIR/.venv"
  if [[ -n "$py312" ]]; then
    ui_caption "Creating the environment"
    "$py312" -m venv "$DIR/.venv" && "$PY" -m pip install -q --upgrade pip >/dev/null 2>&1 && pip_step "${deps[@]}"
  else
    export PATH="$HOME/.local/bin:$PATH"
    command -v uv >/dev/null || quiet_step "Getting uv, which fetches Python 3.12" \
      bash -c 'curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh' || return 1
    quiet_step "Fetching Python 3.12" uv venv --python 3.12 "$DIR/.venv" || return 1
    quiet_step "Installing packages" uv pip install --python "$PY" "${deps[@]}"
  fi
}

do_install() {
  [[ "$(uname -s)-$(uname -m)" == "Darwin-arm64" ]] || { die "Needs a Mac with Apple Silicon (MLX)."; return 1; }
  [[ -d /Applications/Notion.app ]] || { die "Install Notion Desktop first (/Applications/Notion.app)."; return 1; }
  stop; pkill -f notion_service.py 2>/dev/null || true
  UI_TITLE="installer"
  ui_init "Python environment" "Language model" "Index your pages" "Background service"

  ui_start 0
  # Rebuild when missing, broken, or an old environment that carries PyTorch (unused, +300 MB in memory).
  if [[ ! -x "$PY" ]] || ! "$PY" -c "import mlx_vlm, websockets" 2>/dev/null || "$PY" -c "import torch" 2>/dev/null; then
    make_venv || { ui_fail; return 1; }
    ui_done 0
  else ui_done 0 "already set up"; fi

  ui_start 1; ui_caption "Google EmbeddingGemma 2, downloaded from Hugging Face"
  run_py --download || { ui_fail "download failed: check your internet"; return 1; }
  ui_done 1

  ui_start 2
  run_py --index || { ui_fail; return 1; }
  ui_done 2

  ui_start 3; ui_caption "Registering the service that starts at every login"
  mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG")" "$(dirname "$LINK")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$PY</string><string>-u</string><string>$DIR/notion_service.py</string></array>
  <key>WorkingDirectory</key><string>$DIR</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
EOF
  launchctl bootstrap "$DOMAIN" "$PLIST" || { ui_fail; return 1; }
  ln -sf "$DIR/notion-search" "$LINK"
  ui_done 3

  echo "${D}└${N}  ${G}${B}All set.${N} Open Notion and press ${B}Cmd+K${N}."
  echo "   ${D}If Notion was already open, it restarts once so the search can attach.${N}"
  echo "   ${D}Manage it any time with:${N} notion-search"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "   ${Y}!${N} add ~/.local/bin to your PATH to run notion-search from anywhere" ;; esac
  echo
}

do_status() {
  echo "${D}│${N}  $(state_line)"
  if [[ -f "$PLIST" ]]; then
    if ps -axo command= | grep -q "^/Applications/Notion.app/Contents/MacOS/Notion --remote-debugging-port"; then
      ok "Notion is running with the search hook"
    elif ps -axo command= | grep -q "^/Applications/Notion.app/Contents/MacOS/Notion"; then
      echo "${D}│${N}  ${Y}!${N} Notion is open without the hook; the service restarts it within seconds"
    else echo "${D}│${N}  ${D}Notion is not open${N}"; fi
    echo "${D}│${N}"; tail -n 6 "$LOG" 2>/dev/null | sed "s/^/${D}│  /; s/\$/${N}/"
  fi
}

do_restart() { [[ -f "$PLIST" ]] || { die "Not installed."; return 1; }
  launchctl kickstart -k "$DOMAIN/$LABEL" && ok "Restarted"; }

do_reindex() { [[ -f "$PLIST" ]] || { die "Not installed."; return 1; }
  stop; rm -f "$DATA"/index.db*
  UI_TITLE="rebuilding the index"; ui_init "Index your pages" "Background service"
  ui_start 0; run_py --index || { ui_fail; return 1; }; ui_done 0
  ui_start 1; launchctl bootstrap "$DOMAIN" "$PLIST" || { ui_fail; return 1; }; ui_done 1
  echo "${D}└${N}  ${G}${B}Done.${N} The service is running again."; echo; }

do_uninstall() {
  stop; rm -f "$PLIST" "$LINK"; ok "Service removed (Notion itself was never modified)"
  if [[ "${1:-}" == "--purge" ]]; then
    rm -rf "$DATA" "$LOG" "$DIR/.venv"; ok "Index, model (0.9 GB), log and Python environment deleted"
    
  else echo "${D}│${N}  ${D}Kept the index, model and Python environment: install again anytime.${N}"; fi
}

# ── menu ────────────────────────────────────────────────────────────────────

header() {
  printf '\033[H\033[2J\n%s┌%s  %sNotion Search%s\n%s│%s  %s\n%s│%s\n' "$D" "$N" "$B" "$N" "$D" "$N" "$(state_line)" "$D" "$N"
}

pick() {  # pick TITLE OPTION...  (OPTION = "label|description")  -> CHOICE = chosen index; returns 1 on q/esc
  local title="$1"; shift
  local opts=("$@") sel=0 key k2 i label desc width
  width=$(( $(tput cols 2>/dev/null || echo 80) - 22 ))
  tput civis 2>/dev/null
  while true; do
    header
    printf '%s◆%s  %s\n' "$C" "$N" "$title"
    for i in "${!opts[@]}"; do
      label="${opts[$i]%%|*}"; desc=""; [[ "${opts[$i]}" == *"|"* ]] && desc="${opts[$i]#*|}"
      desc="${desc:0:$width}"
      if [[ $i -eq $sel ]]; then printf '%s│%s  %s●%s %s%-10s%s %s%s%s\n' "$D" "$N" "$C" "$N" "$B" "$label" "$N" "$D" "$desc" "$N"
      else printf '%s│%s  %s○ %-10s %s%s\n' "$D" "$N" "$D" "$label" "$desc" "$N"; fi
    done
    printf '%s└%s  %s↑↓ move · enter select · q quit%s\n' "$D" "$N" "$D" "$N"
    IFS= read -rsn1 key
    case "$key" in
      $'\033') read -rsn2 -t 1 k2 || true
               case "$k2" in '[A') ((sel = (sel + ${#opts[@]} - 1) % ${#opts[@]}));; '[B') ((sel = (sel + 1) % ${#opts[@]}));; *) tput cnorm 2>/dev/null; return 1;; esac;;
      k) ((sel = (sel + ${#opts[@]} - 1) % ${#opts[@]}));;
      j) ((sel = (sel + 1) % ${#opts[@]}));;
      q) tput cnorm 2>/dev/null; return 1;;
      '') CHOICE=$sel; tput cnorm 2>/dev/null; return 0;;
    esac
  done
}

menu() {
  while true; do
    local install_label="Install|Set up the search service and index your Notion"
    [[ -f "$PLIST" ]] && install_label="Update|Reinstall the service and refresh dependencies"
    pick "What would you like to do?" "$install_label" \
      "Status|Is it running, and is Notion hooked?" \
      "Restart|Restart the background service" \
      "Reindex|Re-read all your Notion pages from scratch" \
      "Uninstall|Remove the service (Notion is never touched)" \
      "Quit|Close this menu" || break
    header
    case $CHOICE in
      0) do_install;; 1) do_status;; 2) do_restart;; 3) do_reindex;;
      4) pick "What should be removed?" \
              "Service|The background service only; keep the index and model" \
              "Everything|Also the index, model and Python environment" \
              "Cancel|Go back" && header &&
         case $CHOICE in 0) do_uninstall;; 1) do_uninstall --purge;; *) continue;; esac;;
      5) break;;
    esac
    printf '%s│%s\n%s└%s  %sPress any key to go back%s' "$D" "$N" "$D" "$N" "$D" "$N"; read -rsn1 _
  done
  tput cnorm 2>/dev/null; clear
}

case "${1:-menu}" in
  menu) if [[ -t 0 && -t 1 ]]; then menu; else sed -n 2,3p "$0"; fi ;;
  install) do_install;; status) do_status;; restart) do_restart;; reindex) do_reindex;;
  logs) tail -f "$LOG";; uninstall) do_uninstall "${2:-}";;
  *) sed -n 2,3p "$0"; exit 1;;
esac
